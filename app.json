{
  "expo": {
    "name": "HR Dock",
    "slug": "hr-dock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "hrdock",
    "updates": {
      "url": "https://u.expo.dev/ed462a1f-c86c-4fb0-b16c-80bfafa38691",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1829"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hrdock.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HR Dock uses your location only when you clock in or out so your employer can verify the attendance location.",
        "NSFaceIDUsageDescription": "HR Dock uses Face ID to unlock your saved employee session on this device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1829"
      },
      "package": "com.hrdock.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow HR Dock to use Face ID to unlock your saved employee session."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HR Dock to use your location only when you clock in or out."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E8583C",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed462a1f-c86c-4fb0-b16c-80bfafa38691"
      }
    }
  }
}
